{
  "name": "pmf-backend-api",
  "version": "1.0.0",
  "description": "A modern REST API built with Fastify.",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsc --project tsconfig.json --watch && nodemon --watch 'dist/' --exec 'node dist/server.js'",
    "build": "tsc --project tsconfig.json",
    "start": "tsc --project tsconfig.json && node dist/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/auth": "^5.0.3",
    "@fastify/autoload": "^6.3.1",
    "@fastify/jwt": "^10.0.0",
    "@fastify/swagger": "^9.5.2",
    "@fastify/swagger-ui": "^5.2.3",
    "@fastify/type-provider-typebox": "^6.0.0",
    "@prisma/client": "^6.17.1",
    "@sinclair/typebox": "^0.34.41",
    "bcrypt": "^6.0.0",
    "fastify": "^5.6.1",
    "fastify-plugin": "^5.1.0",
    "prisma": "^6.17.1"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^24.8.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.10.2",
    "eslint-plugin-prettier": "^4.2.5",
    "fastify-tsconfig": "^3.0.0",
    "nodemon": "^3.1.10",
    "pino-pretty": "^13.1.2",
    "prettier": "^2.8.8",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT"
}
